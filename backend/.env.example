# ----- Core -----
NODE_ENV=production
PORT=4000
# Public URL of THIS backend (used for OAuth callback + webhook URL)
API_BASE_URL=https://api.stella-hosting.com
# Public URL of the frontend (CORS + post-login redirect)
WEB_BASE_URL=https://stella-hosting.com

# ----- Database (PostgreSQL) -----
DATABASE_URL=postgresql://stella:stella@postgres:5432/stella?schema=public

# ----- Redis -----
REDIS_URL=redis://redis:6379

# ----- Auth / sessions -----
# 32+ char random string. Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32
SESSION_TTL_DAYS=7
COOKIE_DOMAIN=.stella-hosting.com

# ----- Encryption (env-var secrets at rest) -----
# 64 hex chars (32 bytes). Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# ----- GitHub OAuth -----
# Create at https://github.com/settings/developers
# Authorization callback URL: ${API_BASE_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ----- GitHub webhooks -----
# Secret you set on the GitHub webhook; verified via HMAC SHA-256
GITHUB_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32

# ----- Optional IP intelligence (VPN/proxy detection) -----
# Leave blank to disable external lookups (heuristics still apply).
IP_INTEL_URL=
IP_INTEL_API_KEY=

# ----- Abuse prevention thresholds -----
MAX_ACCOUNTS_PER_DEVICE=2
MAX_ACCOUNTS_PER_IP=3

# ----- Deployment runner (Docker-based isolated deployments) -----
RUNNER_ENABLED=true
WORKSPACE_DIR=/var/lib/stella/workspaces
DEPLOY_BASE_IMAGE=node:20-bookworm-slim
# Wildcard domain for deployed apps (optional): https://<slug>.<DEPLOY_DOMAIN>
DEPLOY_DOMAIN=
DEPLOY_PUBLIC_HOST=localhost
DEPLOY_PORT_START=41000
DEPLOY_PORT_END=42000
DEPLOY_CONTAINER_PORT=8080
DEPLOY_CPU_LIMIT=1
DEPLOY_MEMORY_LIMIT=512m
DOCKER_BIN=docker
GIT_BIN=git
# Optional token for cloning private repos (x-access-token)
GIT_CLONE_TOKEN=
